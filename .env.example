# These are the only required env vars — see below for optional integrations.
# PostgreSQL 16+ connection string. The default matches `pnpm db:local`.
# Managed databases (Neon, Supabase, RDS, etc.) and Docker examples are
# documented in DEPLOYMENT.md.
DATABASE_URL=postgresql://kanbanica:kanbanica@localhost:5432/kanbanica

# Session/crypto secret — MUST be at least 32 random characters.
# Generate with: openssl rand -hex 32
APP_SECRET=replace-with-at-least-32-random-characters

# Public base URL of this instance (used in auth links, invites, file URLs).
# No trailing slash. Deprecated alias (still supported): NEXT_PUBLIC_APP_URL
APP_URL=http://localhost:3000

# Everything else (SMTP, Google OAuth, file storage, Web Push, branding) is
# optional and can instead be set from the app itself — the setup wizard's
# /setup step (skippable, revisit any time), or later from Settings →
# Integrations. See docs/integrations.md and docs/credentials/ for details.